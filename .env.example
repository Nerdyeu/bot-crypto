# ---------------------------------------------------------------------------
# trading_bot configuration — COPY this file to `.env` and fill in your values.
#   cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed. Do not put real secrets in
# this example file.
# ---------------------------------------------------------------------------

# === SAFETY GATE ============================================================
# The ONLY value that permits real orders is `live`. Anything else => paper.
# Even with `live`, real trading also requires the --i-understand-the-risks CLI
# flag and a typed confirmation at launch (wired up in Milestone 7).
TRADING_MODE=paper

# === EXCHANGE ===============================================================
# ccxt exchange id, e.g. binance, kraken, coinbase, kucoin, okx ...
EXCHANGE_ID=binance
# Use the exchange testnet/sandbox when available (strongly recommended).
USE_SANDBOX=true

# --- API CREDENTIALS --------------------------------------------------------
# IMPORTANT: create API keys WITHOUT withdrawal permission. Trade-only.
# Leave blank for backtest / paper modes (public data needs no keys).
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Only some exchanges need a passphrase (kucoin, coinbase, okx, ...).
EXCHANGE_API_PASSWORD=

# === MARKET =================================================================
SYMBOL=BTC/USDT
TIMEFRAME=1h

# === CAPITAL ================================================================
# Starting equity (in the quote currency). Used by paper trading and as the
# baseline for risk limits.
INITIAL_CAPITAL=1000

# === RISK LIMITS (nested: prefix RISK__) ====================================
# Max fraction of equity risked on a single trade (0.02 = 2%).
RISK__MAX_POSITION_PCT=0.02
# Halt trading for the day once daily loss exceeds this fraction (0.05 = 5%).
RISK__MAX_DAILY_LOSS_PCT=0.05
# Kill-switch: disable the bot if equity falls below this fraction of the
# initial capital (0.80 = 80%).
RISK__KILL_SWITCH_FLOOR_PCT=0.80
# Hard cap on trades opened per day.
RISK__MAX_TRADES_PER_DAY=10
# Refuse to trade if the quote balance drops below this amount.
RISK__MIN_BALANCE=50
# Mandatory stop-loss distance from entry (0.02 = 2%).
RISK__STOP_LOSS_PCT=0.02
# Take-profit distance from entry (0.04 = 4%).
RISK__TAKE_PROFIT_PCT=0.04

# === STRATEGY (nested: prefix STRATEGY__) ===================================
STRATEGY__NAME=sma_crossover
STRATEGY__SHORT_WINDOW=20
STRATEGY__LONG_WINDOW=50

# === LOGGING ================================================================
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=trading_bot.log

# === ALERTS (optional Telegram) =============================================
# Leave blank to disable. If both are set, alerts (kill-switch / daily loss)
# can be pushed to Telegram in addition to the log file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === DATA ===================================================================
# Folder for historical CSVs used by backtests.
DATA_DIR=trading_bot/data
